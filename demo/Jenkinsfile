pipeline {
    agent any

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {

        stage('Build') {
            steps {
                dir('demo') {
                    bat 'mvnw.cmd clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('demo') {
                    bat 'mvnw.cmd test'
                }
            }
        }

        stage('Deploy: Start Containers') {
            steps {
                dir('demo') {
                    bat 'docker-compose up -d'
                }
            }
        }

        stage('Deploy: Copy Application') {
            steps {
                dir('demo') {
                    bat '''
                        docker cp target/demo-0.0.1-SNAPSHOT.jar web-server:/app/
                        docker cp pom.xml web-server:/app/
                        docker cp mvnw mvnw.cmd web-server:/app/
                        docker cp .mvn web-server:/app/.mvn/
                    '''
                }
            }
        }

        stage('Deploy: Verify & Backup') {
            steps {
                dir('demo') {
                    script {
                        try {
                            bat '''
                                docker exec web-server sh -c "echo 'Deployment completed successfully' && mysqldump -h mysql-db -u root -pHello@123 A-MENG_leangei-db > /app/backup.sql" 2>&1
                            '''
                        } catch (e) {
                            echo "Deploy verification/backup failed: ${e.getMessage()}"
                            currentBuild.result = 'UNSTABLE'
                        }
                    }
                }
            }
        }
    }

    post {
        failure {
            script {
                try {
                    emailext(
                        to: 'srengty@gmail.com',
                        recipientProviders: [
                            [$class: 'DevelopersRecipientProvider']
                        ],
                        subject: 'Build Failed',
                        body: 'Build, test, or deployment failed.'
                    )
                } catch (e) {
                    echo "Email notification failed: ${e.getMessage()}"
                    echo "Please configure SMTP in Jenkins: Manage Jenkins > Configure System > Extended E-mail Notification"
                }
            }
        }
    }
}