pipeline {
    agent any

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {

        stage('Build') {
            steps {
                dir('demo') {
                    bat 'mvnw.cmd clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('demo') {
                    bat 'mvnw.cmd test'
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    if (fileExists('demo/Ansible/deploy.yml')) {
                        echo 'Deploy file exists'
                        echo 'Skipping deploy because Ansible is not installed'
                    }
                }
            }
        }
    }

    post {
        success {
            emailext(
                to: 'leangeimeng1602@gmail.com',
                subject: 'Build Success',
                body: 'Build and tests completed successfully.'
            )
        }

        failure {
            emailext(
                to: 'leangeimeng1602@gmail.com',
                subject: 'Build Failed',
                body: 'Build, test, or deployment failed.'
            )
        }
    }
}