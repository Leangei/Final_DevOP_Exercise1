pipeline {
    agent any

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {

        stage('Build') {
            steps {
                dir('demo') {
                    bat 'mvnw.cmd clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('demo') {
                    bat 'mvnw.cmd test'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('demo') {
                    script {
                        try {
                            bat '''
                                docker pull alpine/ansible:latest
                                docker run --rm ^
                                    -v "%CD%:/ansible:ro" ^
                                    -w /ansible ^
                                    alpine/ansible:latest ^
                                    ansible-playbook -i /ansible/Ansible/hosts.ini /ansible/Ansible/deploy.yml -v
                            '''
                        } catch (e) {
                            echo "Deploy stage failed: ${e.getMessage()}"
                            currentBuild.result = 'UNSTABLE'
                        }
                    }
                }
            }
        }
    }

    post {
        failure {
            script {
                try {
                    emailext(
                        to: 'srengty@gmail.com',
                        recipientProviders: [
                            [$class: 'DevelopersRecipientProvider']
                        ],
                        subject: 'Build Failed',
                        body: 'Build, test, or deployment failed.'
                    )
                } catch (e) {
                    echo "Email notification failed: ${e.getMessage()}"
                    echo "Please configure SMTP in Jenkins: Manage Jenkins > Configure System > Extended E-mail Notification"
                }
            }
        }
    }
}